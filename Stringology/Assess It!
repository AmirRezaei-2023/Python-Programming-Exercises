import re

def validate_email(emailaddress: str) -> bool:
    ptrn = r"^[\w\.]+@[a-zA-Z0-9]+\.[a-zA-Z]{3}$"
    if re.match(ptrn, emailaddress):
        return True
    else:
        return False
    
def validate_phone(phonenumber: str) -> bool:
    if len(phonenumber) == 11:
        ptrn = r"^09\d{9}$"
        if re.match(ptrn, phonenumber):
            return True
        else:
            return False
    if len(phonenumber) == 13:
        ptrn = r"^\+989\d{9}$"
        if re.match(ptrn, phonenumber):
            return True
        else:
            return False
    if len(phonenumber) == 14:
        ptrn = r"^00989\d{9}$"
        if re.match(ptrn, phonenumber):
            return True
        else:
            return False
    else:
        return False
