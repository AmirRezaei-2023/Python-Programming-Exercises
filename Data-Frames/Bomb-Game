board_x, board_y = map(int, input().split())
board = list()
bombs = int(input())
bombs_loc = list()

board = [[0 for i in range(board_y)] for j in range(board_x)]
        
for i in range(bombs):
    a, b = map(int, input().split())
    a -= 1
    b -= 1
    board[a][b] = "*"
    bombs_loc.append([a,b])

for x, y in bombs_loc:
    for i in range(-1, 2):
        for j in range(-1, 2):
            new_x = x + i
            new_y = y + j
            if 0 <= new_x < board_x and 0 <= new_y < board_y:
                if board[new_x][new_y] != '*':
                    board[new_x][new_y] += 1           

for raw in board:
    print(*raw)
